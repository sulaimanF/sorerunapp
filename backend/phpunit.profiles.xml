<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Stages 01-07 on isolated MySQL 8.4">
            <file>tests/Feature/Schema/MembershipCoreSchemaTest.php</file>
            <file>tests/Feature/Models/MembershipModelsTest.php</file>
            <file>tests/Feature/Auth/RegisterMemberTest.php</file>
            <file>tests/Feature/Auth/RegistrationConcurrencyTest.php</file>
            <file>tests/Feature/Auth/BrowserSessionTest.php</file>
            <file>tests/Feature/Auth/EmailVerificationTest.php</file>
            <file>tests/Feature/Auth/EmailVerificationBrowserUrlTest.php</file>
            <file>tests/Feature/Notifications/NotificationOutboxTest.php</file>
            <file>tests/Feature/Auth/VerificationConcurrencyTest.php</file>
            <file>tests/Feature/Members/MemberProfileTest.php</file>
            <file>tests/Feature/Members/ProfileConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="OUTBOX_DISPATCH_ON_COMMIT" value="false" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="sorerunapp_test" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="database" force="true"/>
        <env name="SESSION_CONNECTION" value="mysql" force="true"/>
        <env name="SESSION_TABLE" value="sessions" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
    </php>
</phpunit>
