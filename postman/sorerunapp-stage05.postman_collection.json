                  "    pm.expect(['membership_activated', 'already_active']).to.include(result.result);",
                  "    pm.expect(result.membership.status).to.equal('active');",
                  "    pm.expect(result).not.to.have.property('qr_payload');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
