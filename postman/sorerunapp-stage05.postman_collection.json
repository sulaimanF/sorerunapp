        {
          "name": "06 - Cari email verifikasi di Mailpit",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mailpit_base_url}}/api/v1/messages?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.unset('mailpit_message_id');",
                  "  pm.environment.set('verification_url', '');",
                  "  const recipient = pm.environment.get('test_email').trim().toLowerCase();",
                  "  const messages = pm.response.json().messages || [];",
                  "  const match = messages.find(function (message) {",
                  "    return message.Subject === 'Verifikasi email sorerunapp' && (message.To || []).some(function (to) { return (to.Address || '').toLowerCase() === recipient; });",
                  "  });",
                  "  if (!match) throw new Error('Email belum ada. Pastikan Mailpit dan queue mail berjalan, tunggu beberapa detik, lalu Send request ini kembali.');",
                  "  pm.environment.set('mailpit_message_id', match.ID);",
                  "  pm.test('Email verifikasi akun uji ditemukan', function () {pm.expect(match.ID).to.be.a('string');});",
                  "}"
                ]
              }
            }
          ],
          "response": [],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "07 - Baca email dan simpan tautan",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mailpit_base_url}}/api/v1/message/{{mailpit_message_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('mailpit_message_id')) throw new Error('Jalankan Cari email dahulu.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('verification_url', '');",
                  "  const message = pm.response.json();",
                  "  const recipient = pm.environment.get('test_email').trim().toLowerCase();",
                  "  if (message.Subject !== 'Verifikasi email sorerunapp' || !(message.To || []).some(function (to) {return (to.Address || '').toLowerCase() === recipient;})) {",
                  "    throw new Error('Email bukan verifikasi untuk akun uji ini.');",
                  "  }",
                  "  const text = (message.HTML || '') + '\\n' + (message.Text || '');",
                  "  const candidates = text.match(/https?:\\/\\/[^\\s<>\"']+/g) || [];",
                  "  const prefix = pm.environment.get('api_base_url') + '/api/v1/auth/email-verification/';",
                  "  const links = candidates.map(function (url) { return url.replace(/&amp;/g, '&'); }).map(function (url) {",
                  "    const bridge = pm.environment.get('frontend_origin') + '/verify-email#verification=';",
                  "    if (url.indexOf(bridge) === 0) { try { return decodeURIComponent(url.slice(bridge.length)); } catch (_) { return ''; } }",
                  "    return url;",
                  "  });",
                  "  const link = links.find(function (url) {return url.indexOf(prefix) === 0 && /[?&]signature=[a-f0-9]{64}(?:&|$)/.test(url);});",
                  "  if (!link) throw new Error('Tautan verifikasi untuk API lokal tidak ditemukan. Periksa APP_URL.');",
                  "  pm.environment.set('verification_url', link);",
                  "  pm.test('Tautan lokal siap dipakai', function () {pm.expect(link.indexOf(prefix)).to.equal(0);});",
                  "}"
                ]
              }
            }
          ],
          "response": [],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "08 - Verifikasi email pemilik",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
