              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const safeLink = pm.environment.get('verification_url') || '';",
                  "const expected = pm.environment.get('api_base_url') + '/api/v1/auth/email-verification/';",
                  "if (safeLink.indexOf(expected) !== 0 || !/^http:\\/\\/localhost:8000\\/api\\/v1\\/auth\\/email-verification\\/\\d+\\/[a-f0-9]{40}\\?[^#\\s]*signature=[a-f0-9]{64}[^#\\s]*$/.test(safeLink)) {",
                  "  throw new Error('Ambil tautan verifikasi melalui request Baca email dahulu.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
