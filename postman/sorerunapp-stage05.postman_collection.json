              "mode": "raw",
              "raw": "{{src_register_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove('X-XSRF-TOKEN');",
                  "pm.cookies.jar().get(pm.environment.get('api_base_url') + '/', 'XSRF-TOKEN', function (error, value) {",
                  "  if (error) throw new Error('Tambahkan localhost pada Cookies > Domains allowlist.');",
                  "  if (!value) throw new Error('Kirim Ambil CSRF dahulu. Cookie jar API harus aktif.');",
                  "  pm.request.headers.upsert({key: 'X-XSRF-TOKEN', value: decodeURIComponent(value)});",
                  "});",
                  "",
                  "pm.environment.set('verification_url', ''); pm.environment.unset('mailpit_message_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Registrasi diterima', function () {pm.expect(pm.response.json().data.result).to.equal('registration_received');});"
                ]
              }
            }
          ],
          "response": []
