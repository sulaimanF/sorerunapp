{
  "info": {
    "_postman_id": "7fb4799e-878e-4ee0-953f-8c2fd0be6147",
    "name": "sorerunapp - Verifikasi dan Aktivasi (Tahap 05)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Khusus lokal. Baca PANDUAN.md. Kirim folder utama berurutan; ulangi Cari email jika SMTP belum selesai. No Auth, cookie API aktif, Mailpit cookie jar dimatikan. Folder opsional hanya pada titik yang dijelaskan dalam panduan."
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "['api_base_url', 'frontend_origin', 'test_email', 'test_password', 'privacy_version', 'terms_version', 'mailpit_base_url'].forEach(function (key) {",
          "  if (!pm.environment.get(key)) throw new Error('Isi environment tahap 05: ' + key);",
          "});",
          "const srcApiRoot = pm.environment.get('api_base_url');",
          "const srcMailRoot = pm.environment.get('mailpit_base_url');",
          "if (srcApiRoot !== 'http://localhost:8000' || srcMailRoot !== 'http://127.0.0.1:8025') {",
          "  throw new Error('Collection ini khusus lokal: API localhost:8000 dan Mailpit 127.0.0.1:8025.');",
          "}",
          "const srcEmail = pm.environment.get('test_email');",
          "const srcPassword = pm.environment.get('test_password');",
          "pm.variables.set('src_login_body', JSON.stringify({email: srcEmail, password: srcPassword}));",
          "pm.variables.set('src_register_body', JSON.stringify({",
          "  full_name: 'Anggota Verifikasi Postman', email: srcEmail,",
          "  password: srcPassword, password_confirmation: srcPassword,",
          "  birth_date: '2000-01-01', phone: '081234567890', city: 'Kota Uji',",
          "  privacy_notice_accepted: true, privacy_notice_version: pm.environment.get('privacy_version'),",
          "  terms_accepted: true, terms_version: pm.environment.get('terms_version')",
          "}));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const srcResolvedUrl = pm.variables.replaceIn(pm.request.url.toString());",
          "if (srcResolvedUrl.indexOf(pm.environment.get('api_base_url') + '/api/') === 0) {",
          "  pm.test('API memakai no-store', function () { pm.expect(pm.response.headers.get('Cache-Control') || '').to.include('no-store'); });",
          "  if (pm.response.code !== 204) {",
          "    const envelope = pm.response.json();",
          "    pm.test('Envelope memiliki request_id', function () {",
          "      pm.expect(envelope.meta.request_id).to.match(/^[0-9a-f-]{36}$/i);",
          "      pm.expect(pm.response.headers.get('X-Request-ID')).to.equal(envelope.meta.request_id);",
          "    });",
          "    if (pm.response.code >= 400) {",
          "      pm.test('Error aman', function () {",
          "        pm.expect(envelope.error.code).to.be.a('string');",
          "        pm.expect(envelope.error.fields).to.be.an('object');",
          "        pm.expect(envelope).not.to.have.property('exception');",
          "        pm.expect(envelope).not.to.have.property('trace');",
          "      });",
          "    }",
          "  }",
          "}"
        ]
      }
    }
  ],
