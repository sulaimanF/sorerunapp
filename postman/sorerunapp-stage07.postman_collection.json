{
  "info": {
    "_postman_id": "80cce497-5a62-43a8-b4c9-6b1cb089300a",
    "name": "sorerunapp — Tahap 07 Profil Anggota",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Khusus API lokal dan akun uji sintetis yang sudah terdaftar. Request 05 mengubah biodata akun yang login. Tidak membuat akun atau mengirim data ke pihak lain. Gunakan berurutan."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "['api_base_url','frontend_origin','test_email','test_password'].forEach(function (key) {",
          "  if (!pm.environment.get(key)) throw new Error('Isi environment tahap 07: ' + key);",
          "});",
          "if (pm.environment.get('api_base_url') !== 'http://localhost:8000' || pm.environment.get('frontend_origin') !== 'http://localhost:3000') {",
          "  throw new Error('Koleksi ini khusus lokal: localhost:8000 dan localhost:3000.');",
          "}",
          "pm.variables.set('src_profile_login', JSON.stringify({email:pm.environment.get('test_email'),password:pm.environment.get('test_password')}));",
          "pm.variables.set('src_profile_patch', JSON.stringify({full_name:'Anggota Profil Postman',birth_date:'2012-02-29',phone:'081234567890',city:'Kota Postman',gender:null}));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const url = pm.variables.replaceIn(pm.request.url.toString());",
          "if (url.indexOf(pm.environment.get('api_base_url') + '/api/') === 0) {",
          "  pm.test('API privat memakai no-store', function () { pm.expect(pm.response.headers.get('Cache-Control') || '').to.include('no-store'); });",
          "  if (pm.response.code !== 204) {",
          "    const body = pm.response.json();",
          "    pm.test('request_id konsisten', function () { pm.expect(body.meta.request_id).to.match(/^[0-9a-f-]{36}$/i); pm.expect(pm.response.headers.get('X-Request-ID')).to.equal(body.meta.request_id); });",
          "    if (pm.response.code >= 400) pm.test('Error tidak membocorkan detail internal', function () { pm.expect(body.error.code).to.be.a('string'); pm.expect(body).not.to.have.property('exception'); pm.expect(body).not.to.have.property('trace'); });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "src_profile_member_number",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Ambil CSRF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          },
          {
            "key": "Referer",
            "value": "{{frontend_origin}}/"
          }
        ],
        "url": "{{api_base_url}}/sanctum/csrf-cookie"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Login akun uji yang sudah terdaftar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          },
          {
            "key": "Referer",
            "value": "{{frontend_origin}}/"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{{src_profile_login}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.remove('X-XSRF-TOKEN');",
              "pm.cookies.jar().get(pm.environment.get('api_base_url') + '/', 'XSRF-TOKEN', function (error, value) {",
              "  if (error) throw new Error('Tambahkan localhost ke Cookies > Domains allowlist.');",
              "  if (!value) throw new Error('Kirim Ambil CSRF terlebih dahulu dan aktifkan cookie jar.');",
              "  pm.request.headers.upsert({key: 'X-XSRF-TOKEN', value: decodeURIComponent(value)});",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.test('Email sesuai akun uji', function () { pm.expect(pm.response.json().data.user.email).to.equal(pm.environment.get('test_email').trim().toLowerCase()); });"
            ]
          }
        }
      ],
      "response": []
    },
