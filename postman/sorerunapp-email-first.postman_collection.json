          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_origin}}/api/v1/auth/email-verification/resend",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
