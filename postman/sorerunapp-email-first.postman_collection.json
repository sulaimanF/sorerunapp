            "exec": [
              "pm.test(\"Status 202\", () => pm.response.to.have.status(202));",
              "pm.test(\"Hasil sesuai kontrak\", () => pm.expect(pm.response.json().data.result).to.equal(\"verification_requested\"));",
              "pm.test(\"Respons sama\", () => pm.expect(JSON.stringify(pm.response.json().data)).to.equal(pm.environment.get(\"generic_resend_data\")));",
              "pm.test(\"Cooldown sama\", () => pm.expect(pm.response.headers.get(\"Retry-After\")).to.equal(\"60\"));"
            ]
          }
        }
