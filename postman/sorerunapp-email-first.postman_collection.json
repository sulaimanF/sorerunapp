          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_origin}}/api/v1/auth/email-verification/resend",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"unknown-email-first@example.test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 202\", () => pm.response.to.have.status(202));",
              "pm.test(\"Hasil sesuai kontrak\", () => pm.expect(pm.response.json().data.result).to.equal(\"verification_requested\"));",
              "pm.test(\"Cooldown generik\", () => pm.expect(pm.response.headers.get(\"Retry-After\")).to.equal(\"60\"));",
              "pm.environment.set(\"generic_resend_data\", JSON.stringify(pm.response.json().data));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Resend akun sudah verified tetap generik",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
